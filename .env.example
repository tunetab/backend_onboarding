# Images
IMAGE_POSTGRES=gitlab.icerockdev.com:4567/docker/alpine-postgres-postgis-15:latest
IMAGE_RUSTFS=rustfs/rustfs:1.0.0-alpha.87

# Credentials
DATABASE_HOST=#{PROJECT_IP}
DATABASE_PORT=5432
DATABASE_NAME=db
DATABASE_USER=user
DATABASE_PASS=pass
DATABASE_SCHEMA=public
DATABASE_INITSQL=set time zone UTC
DATABASE_TIMEOUT=600000
DATABASE_POOL_SIZE=5
DATABASE_ROOT=pass

# JWT
JWT_AUDIENCE=#{PROJECT_NAME}-audience
JWT_SECRET=fasd7hgdh5HGF5FDd235nadnsdda
JWT_ISSUER=http://0.0.0.0:80
# 5h
JWT_ACCESS_TOKEN_TTL=18000
# 1 week
JWT_REFRESH_TOKEN_TTL=604800

# Server
SERVER_PORT=8080
SERVER_HOST=#{PROJECT_IP}

# S3 (RustFS)
S3_HOST=#{PROJECT_IP}
S3_BUCKET=#{PROJECT_NAME}-bucket
S3_ENDPOINT=http://#{PROJECT_IP}:9000
S3_REGION=us-east-1
S3_ALLOWED_MIME_TYPES=image/png,image/jpg,image/jpeg
S3_ACCESS_KEY_ID=my_access_key
S3_SECRET_ACCESS_KEY=my_secret_key

#CORS
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS,HEAD
CORS_MAX_AGE=3600
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=*
CORS_ALLOWED_ORIGINS=*

# API
ENV=dev
API_BASE_URL=http://#{PROJECT_IP}
ADMIN_BASE_URL=http://#{PROJECT_IP}
