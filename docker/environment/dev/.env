# Images
IMAGE_POSTGRES=gitlab.icerockdev.com:4567/docker/alpine-postgres-postgis-15:latest
IMAGE_RUSTFS=rustfs/rustfs:1.0.0-alpha.87

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=user
DATABASE_NAME=db
DATABASE_SCHEMA=public
DATABASE_INITSQL=set time zone UTC
DATABASE_TIMEOUT=600000
DATABASE_POOL_SIZE=5

SERVER_PORT=8080
SERVER_HOST=0.0.0.0

BACKUP_DIR='/var/www/db-backups'

JWT_AUDIENCE=back_onboarding-audience
JWT_ISSUER=http://0.0.0.0:80
# 5h
JWT_ACCESS_TOKEN_TTL=18000
# 1 week
JWT_REFRESH_TOKEN_TTL=604800

MAX_MEMORY=256m
MIN_MEMORY=128m
THREAD_MEMORY=24m

S3_BUCKET=back_onboarding-bucket
S3_ENDPOINT=https://storage.cspanov_onboarding.icerockdev.com
S3_REGION=us-east-1

ENV=dev
PUID=www-data
PGID=www-data

CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS,HEAD
CORS_MAX_AGE=3600
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=*
CORS_ALLOWED_ORIGINS=*

ADMIN_SERVER_NAME=admin.cspanov_onboarding.icerockdev.com
API_SERVER_NAME=api.cspanov_onboarding.icerockdev.com
API_BASE_URL=https://api.cspanov_onboarding.icerockdev.com
ADMIN_BASE_URL=https://admin.cspanov_onboarding.icerockdev.com
STORAGE_SERVER_NAME=storage.cspanov_onboarding.icerockdev.com
STORAGE_WEB_PANEL_NAME=storage-panel.cspanov_onboarding.icerockdev.com
