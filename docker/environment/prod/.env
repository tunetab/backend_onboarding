# Images
IMAGE_POSTGRES=gitlab.icerockdev.com:4567/docker/alpine-postgres-postgis-15:latest
IMAGE_RUSTFS=rustfs/rustfs:1.0.0-alpha.87

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=user
DATABASE_NAME=db
DATABASE_SCHEMA=public
DATABASE_INITSQL=set time zone UTC
DATABASE_TIMEOUT=600000
DATABASE_POOL_SIZE=5

SERVER_PORT=8080
SERVER_HOST=0.0.0.0

BACKUP_DIR='/var/www/db-backups'

JWT_AUDIENCE=#{PROJECT_NAME}-audience
JWT_ISSUER=http://0.0.0.0:80
# 5h
JWT_ACCESS_TOKEN_TTL=18000
# 1 week
JWT_REFRESH_TOKEN_TTL=604800

MAX_MEMORY=512m
MIN_MEMORY=256m
THREAD_MEMORY=32m

S3_BUCKET=#{PROJECT_NAME}-bucket
S3_ENDPOINT=https://storage.#{PROD_DOMAIN}
S3_REGION=us-east-1

ENV=prod
PUID=www-data
PGID=www-data

CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS,HEAD
CORS_MAX_AGE=3600
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=*
CORS_ALLOWED_ORIGINS=https://api.#{PROD_DOMAIN},https://admin.#{PROD_DOMAIN}

ADMIN_SERVER_NAME=admin.#{PROD_DOMAIN}
API_SERVER_NAME=api.#{PROD_DOMAIN}
API_BASE_URL=https://api.#{PROD_DOMAIN}
ADMIN_BASE_URL=https://admin.#{PROD_DOMAIN}
STORAGE_SERVER_NAME=storage.#{PROD_DOMAIN}
STORAGE_WEB_PANEL_NAME=storage-panel.#{PROD_DOMAIN}
